      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Icon(Icons.info_outline, size: 22, color: AppColors.colorPrimary),
          const SizedBox(width: 12),
          Expanded(
            child: Text(
              _t(
                context,
                en: 'Setting a competitive nightly rate can help you get your first bookings faster. Check similar listings in your area for guidance.',
                sw: 'Kuweka bei shindani ya usiku kunaweza kukusaidia kupata uhifadhi wa kwanza haraka. Angalia matangazo yanayofanana karibu nawe kwa mwongozo.',
              ),
              style: TextStyle(
                fontSize: 14,
                color: _isDark(context)
                    ? Colors.white
