<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="meta.title">HostBora — Collect rent on time, across BnB and long-term rent</title>
    <meta
      name="description"
      data-i18n="meta.description"
      content="HostBora helps landlords and property managers in Tanzania collect rent on time — automatic WhatsApp and SMS reminders, M-Pesa payment records in TZS, and reports that prove every shilling. Short-stay BnB and long-term rent in one app."
    />
    <meta name="theme-color" content="#1C6E64" />
    <link rel="canonical" href="https://www.hostbora.co.tz/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.hostbora.co.tz/" />
    <meta property="og:title" content="HostBora — Collect rent on time" />
    <meta
      property="og:description"
      content="Automatic rent reminders on WhatsApp and SMS, M-Pesa payments recorded in TZS, and reports that prove every shilling. BnB and long-term rent in one app."
    />
    <meta property="og:image" content="https://www.hostbora.co.tz/assets/feature_graphic.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="./assets/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="./assets/host_bora_logo.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link rel="stylesheet" href="./styles.css" />
  </head>

  <body>
    <a class="skip-link" href="#main" data-i18n="skip">Skip to content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="#main" data-i18n-aria-label="brand.home" aria-label="HostBora home">
          <span class="brand__mark" aria-hidden="true">
            <img src="./assets/ui/logo-mark-a.svg" width="27.5529" height="25.4743" alt="" />
            <img src="./assets/ui/logo-mark-b.svg" width="13.2931" height="17.8369" alt="" />
          </span>
          <img
            class="brand__wordmark"
            src="./assets/ui/wordmark-dark.svg"
            width="115.528"
            height="18.9595"
            alt="HostBora"
          />
        </a>

        <button
          class="menu-toggle"
          id="menuBtn"
          type="button"
          aria-expanded="false"
          aria-controls="nav"
          data-i18n-aria-label="menu.open"
          aria-label="Open menu"
        >
          <span></span><span></span><span></span>
        </button>

        <nav class="nav" id="nav" data-i18n-aria-label="nav.label" aria-label="Primary">
          <a href="#features" data-i18n="nav.features">Features</a>
          <a href="#workspaces" data-i18n="nav.workspaces">Workspaces</a>
          <a href="#audience" data-i18n="nav.audience">Who uses it</a>
          <a href="#pricing" data-i18n="nav.pricing">Pricing</a>
          <a href="#trust" data-i18n="nav.trust">Trust</a>

          <label class="lang" data-i18n-aria-label="lang.label" aria-label="Language">
            <select id="langSelect">
              <option value="en">English</option>
              <option value="sw">Kiswahili</option>
            </select>
          </label>

          <a class="btn btn--soft" href="#contact">
            <span data-i18n="nav.getStarted">Get started</span>
            <img src="./assets/ui/arrow-up-right-teal.svg" width="20" height="20" alt="" />
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ───────────────────────────── Hero ───────────────────────────── -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero__head">
          <div class="hero__lead">
            <p class="eyebrow">
              <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
              <span data-i18n="hero.badge">Built in Dar es Salaam for Tanzanian landlords</span>
            </p>
            <h1 class="display display--xl" id="hero-title" data-i18n="hero.title">
              Collect rent on time — and prove every shilling.
            </h1>
          </div>

          <div class="hero__aside">
            <p class="hero__sub">
              <strong data-i18n="hero.tagline"
                >Automatic reminders on WhatsApp and SMS. Payments recorded in TZS.</strong
              >
              <span data-i18n="hero.lead"
                >HostBora runs short-stay BnB and long-term rent in one app — chase rent without
                awkward calls, record M-Pesa and mobile money against the right unit, and export a
                report that holds up with a bank, an owner, or the TRA.</span
              >
            </p>

            <div class="hero__actions">
              <a
                class="btn btn--primary"
                href="https://play.google.com/store/apps/details?id=tz.co.artbel.paa_yangu"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-i18n="cta.install">Install now</span>
                <img src="./assets/ui/arrow-up-right-white.svg" width="20" height="20" alt="" />
              </a>

              <div class="store-note">
                <span class="store-note__label" data-i18n="cta.availableOn">Available on</span>
                <span class="store-chips">
                  <a
                    href="https://apps.apple.com/app/host-bora/id6760237277"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Download on the App Store"
                  >
                    <img src="./assets/ui/store-appstore.png" width="24" height="24" alt="App Store" />
                  </a>
                  <span aria-hidden="true">+</span>
                  <a
                    href="https://play.google.com/store/apps/details?id=tz.co.artbel.paa_yangu"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Get it on Google Play"
                  >
                    <img src="./assets/ui/store-play.png" width="24" height="24" alt="Google Play" />
                  </a>
                </span>
              </div>
            </div>

            <p class="hero__version" data-i18n="app.version">App v1.5.8 · Updated October 2026</p>
          </div>
        </div>

        <div class="hero__stage">
          <div class="hero__stage-inner">
            <ul class="chips chips--left">
              <li class="chip">
                <span class="chip__dot chip__dot--violet" aria-hidden="true"></span>
                <span data-i18n="chip.vault">Document Vault</span>
              </li>
              <li class="chip">
                <span class="chip__dot chip__dot--peach" aria-hidden="true"></span>
                <span data-i18n="chip.calendar">Host Calendar</span>
              </li>
              <li class="chip">
                <span class="chip__dot chip__dot--lime" aria-hidden="true"></span>
                <span data-i18n="chip.access">Guest Access</span>
              </li>
            </ul>

            <figure class="hero-phone">
              <img
                src="./assets/home.jpg"
                width="239"
                height="512"
                alt="The HostBora home screen showing quick actions for calendar, tenants, messaging and reports"
                loading="eager"
                decoding="async"
              />
            </figure>

            <ul class="chips chips--right">
              <li class="chip">
                <span class="chip__dot chip__dot--amber" aria-hidden="true"></span>
                <span data-i18n="chip.ai">AI Manager</span>
              </li>
              <li class="chip">
                <span class="chip__dot chip__dot--violet" aria-hidden="true"></span>
                <span data-i18n="chip.report">Daily Report</span>
              </li>
              <li class="chip">
                <span class="chip__dot chip__dot--teal" aria-hidden="true"></span>
                <span data-i18n="chip.maintenance">Maintenance</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ─────────────────────────── Features ─────────────────────────── -->
      <section class="section" id="features">
        <div class="shell">
          <div class="section__head section__head--split">
            <div>
              <p class="eyebrow">
                <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
                <span data-i18n="features.kicker">Daily toolkit</span>
              </p>
              <h2 class="display" data-i18n="features.title">
                Everything landlords and managers need daily
              </h2>
            </div>
            <p class="section__sub" data-i18n="features.sub">
              One calm toolkit for income, operations, people, and records — whether you host nights
              or collect monthly rent.
            </p>
          </div>

          <div class="bento">
            <article class="tile tile--wide">
              <div class="tile__visual">
                <div class="mock-rows">
                  <div class="mock-row">
                    <span class="mock-row__icon mock-row__icon--teal" aria-hidden="true"></span>
                    <span class="mock-row__text">
                      <strong>Rent · Unit B4</strong>
                      <small>M-Pesa · 2:14 pm</small>
                    </span>
                    <span class="mock-row__amt mock-row__amt--in">+450,000</span>
                  </div>
                  <div class="mock-row">
                    <span class="mock-row__icon mock-row__icon--violet" aria-hidden="true"></span>
                    <span class="mock-row__text">
                      <strong>Plumbing repair</strong>
                      <small>Airtel Money · 4:02 pm</small>
                    </span>
                    <span class="mock-row__amt">−85,000</span>
                  </div>
                  <div class="mock-row">
                    <span class="mock-row__icon mock-row__icon--amber" aria-hidden="true"></span>
                    <span class="mock-row__text">
                      <strong>Guest stay · 3 nights</strong>
                      <small>Mixx by Yas · 6:30 pm</small>
                    </span>
                    <span class="mock-row__amt mock-row__amt--in">+210,000</span>
                  </div>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.payments.title">Payments &amp; expenses</h3>
                <p data-i18n="feat.payments.desc">
                  Record M-Pesa, Tigo Pesa, Airtel Money and cash against the right unit and tenant.
                  Log expenses as they happen and see cash flow without a spreadsheet.
                </p>
              </div>
            </article>

            <article class="tile">
              <div class="tile__visual">
                <div class="mock-chat">
                  <p class="mock-chat__bubble">
                    Habari Joseph, rent for Unit B4 is due on 1 Nov — TZS 450,000.
                  </p>
                  <p class="mock-chat__meta">Sent automatically · WhatsApp</p>
                  <span class="mock-chat__tag">Delivered</span>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.chase.title">Rent chasing on WhatsApp</h3>
                <p data-i18n="feat.chase.desc">
                  Schedule reminders for rent, renewals and check-ins over WhatsApp or SMS — so the
                  follow-up happens even when you forget.
                </p>
              </div>
            </article>

            <article class="tile">
              <div class="tile__visual">
                <div class="mock-stat">
                  <span class="mock-stat__row"><em>Rent</em><strong>2,860,000</strong></span>
                  <span class="mock-stat__row mock-stat__row--good"
                    ><em>Profit</em><strong>1,139,000</strong></span
                  >
                  <svg class="mock-stat__spark" viewBox="0 0 160 52" fill="none" aria-hidden="true">
                    <path
                      d="M2 46 L34 40 L62 42 L90 26 L120 18 L158 6"
                      stroke="#1C6E64"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                    <path
                      d="M2 50 L34 47 L62 48 L90 38 L120 34 L158 26"
                      stroke="#CBD5E1"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-dasharray="4 4"
                    />
                  </svg>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.reports.title">Reports &amp; profitability</h3>
                <p data-i18n="feat.reports.desc">
                  See income against spend per property, then export to PDF, Excel or CSV for an
                  owner, a bank or your accountant.
                </p>
              </div>
            </article>
          </div>

          <div class="bento bento--trio">
            <article class="tile">
              <div class="tile__visual">
                <div class="mock-ai">
                  <p class="mock-ai__q">What&apos;s my occupancy this month?</p>
                  <p class="mock-ai__a">
                    82% across 3 properties. Two leases expire in November — want the list?
                  </p>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.ai.title">AI Manager</h3>
                <p data-i18n="feat.ai.desc">
                  Ask about occupancy, arrears, income or expiring leases in plain language and get
                  answers drawn from your own portfolio.
                </p>
              </div>
            </article>

            <article class="tile">
              <div class="tile__visual">
                <div class="mock-tasks">
                  <label class="mock-task"><input type="checkbox" checked disabled /> Deep clean · Unit A2</label>
                  <label class="mock-task"><input type="checkbox" checked disabled /> Guard rota signed</label>
                  <label class="mock-task"><input type="checkbox" disabled /> Fix geyser · B1</label>
                  <span class="mock-tasks__tag">3 staff assigned</span>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.staff.title">Staff, tasks &amp; permissions</h3>
                <p data-i18n="feat.staff.desc">
                  Assign cleaners, guards and maintenance with due dates, then control exactly what
                  each staff member can see.
                </p>
              </div>
            </article>

            <article class="tile">
              <div class="tile__visual">
                <div class="mock-lock">
                  <span class="mock-lock__code">4 8 2 9 1 6</span>
                  <span class="mock-lock__label">Guest code · expires at checkout</span>
                  <span class="mock-lock__log">Entry log · 14:06 · Front door</span>
                </div>
              </div>
              <div class="tile__body">
                <h3 data-i18n="feat.access.title">Smart access &amp; entry logs</h3>
                <p data-i18n="feat.access.desc">
                  Issue guest codes to supported smart locks and keep a timestamped entry log — no
                  more meeting guests to hand over keys.
                </p>
              </div>
            </article>
          </div>

          <ul class="more-features">
            <li><strong data-i18n="more.vault.title">Document vault</strong><span data-i18n="more.vault.desc">Leases, IDs and receipts per property</span></li>
            <li><strong data-i18n="more.calendar.title">Calendar sync</strong><span data-i18n="more.calendar.desc">Link channels, cut double bookings</span></li>
            <li><strong data-i18n="more.reminders.title">Reminders</strong><span data-i18n="more.reminders.desc">Renewals, check-ins, recurring chores</span></li>
            <li><strong data-i18n="more.fx.title">Multi-currency</strong><span data-i18n="more.fx.desc">TZS first, with live FX for diaspora owners</span></li>
            <li><strong data-i18n="more.referrals.title">Referrals &amp; rewards</strong><span data-i18n="more.referrals.desc">Invite other landlords, earn free months</span></li>
            <li><strong data-i18n="more.score.title">Host Score</strong><span data-i18n="more.score.desc">Challenges that keep records up to date</span></li>
          </ul>
        </div>
      </section>

      <!-- ────────────────────────── Workspaces ────────────────────────── -->
      <section class="section section--alt" id="workspaces">
        <div class="shell">
          <div class="section__head section__head--center">
            <p class="eyebrow">
              <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
              <span data-i18n="workspaces.kicker">BnB + Rent</span>
            </p>
            <h2 class="display" data-i18n="workspaces.title">Two workspaces, one app</h2>
            <p class="section__sub" data-i18n="workspaces.sub">
              Switch between BnB and Rent anytime — same properties, tailored flows.
            </p>
          </div>

          <div class="workspace-grid">
            <article class="workspace">
              <img
                class="workspace__photo"
                src="./assets/ui/workspace-bnb.png"
                alt="A furnished short-stay apartment with dining table and sofa"
                loading="lazy"
                decoding="async"
              />
              <div class="workspace__overlay">
                <span class="badge" data-i18n="workspaces.bnb.badge">BnB</span>
                <h3 data-i18n="workspaces.bnb.title">Short-stay hosting</h3>
                <p data-i18n="workspaces.bnb.desc">
                  Manage nightly bookings, guest turnover, cleaning schedules and hospitality-style
                  income. Ideal for furnished apartments, guest houses and holiday lets.
                </p>
              </div>
            </article>

            <article class="workspace">
              <img
                class="workspace__photo"
                src="./assets/ui/workspace-rent.png"
                alt="A furnished long-let bedroom with framed art and a large window"
                loading="lazy"
                decoding="async"
              />
              <div class="workspace__overlay">
                <span class="badge" data-i18n="workspaces.rent.badge">Rent</span>
                <h3 data-i18n="workspaces.rent.title">Long-term rentals</h3>
                <p data-i18n="workspaces.rent.desc">
                  Run monthly leases, tenant records, rent collection and building-level expenses.
                  Built for landlords and managers with recurring income.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ─────────────────────────── Audience ─────────────────────────── -->
      <section class="section" id="audience">
        <div class="shell">
          <div class="section__head section__head--center">
            <p class="eyebrow">
              <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
              <span data-i18n="audience.kicker">Who it&rsquo;s for</span>
            </p>
            <h2 class="display" data-i18n="audience.title">Made for people who run properties</h2>
            <p class="section__sub" data-i18n="audience.sub">
              Whether you own one unit or manage a growing portfolio across Dar, Arusha or beyond.
            </p>
          </div>

          <div class="audience-grid">
            <article class="persona persona--blue">
              <div class="persona__copy">
                <h3 class="display display--sm" data-i18n="audience.landlords.title">Landlords</h3>
                <p data-i18n="audience.landlords.desc">
                  See rent collected, who still owes, vacancies and cost per unit — without
                  juggling notebooks and screenshots.
                </p>
              </div>
              <img
                class="persona__photo"
                src="./assets/home_1.png"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </article>

            <article class="persona persona--violet">
              <div class="persona__copy">
                <h3 class="display display--sm" data-i18n="audience.managers.title">
                  Property managers
                </h3>
                <p data-i18n="audience.managers.desc">
                  Oversee multiple owners or buildings with staff workflows, expenses and reports
                  your clients can actually trust.
                </p>
              </div>
              <img
                class="persona__photo"
                src="./assets/home_2.png"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </article>

            <article class="persona persona--peach persona--row">
              <div class="persona__copy">
                <h3 class="display display--sm" data-i18n="audience.hosts.title">
                  Hosts &amp; operators
                </h3>
                <p data-i18n="audience.hosts.desc">
                  Run BnB or mixed portfolios — from boutique stays to serviced apartments — with
                  bookings and operations in sync.
                </p>
              </div>
              <ul class="persona__tags">
                <li data-i18n="audience.hosts.tag1">Nightly + monthly income side by side</li>
                <li data-i18n="audience.hosts.tag2">Cleaning and turnover tasks</li>
                <li data-i18n="audience.hosts.tag3">Guest codes and entry logs</li>
                <li data-i18n="audience.hosts.tag4">One report per owner</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <!-- ──────────────────────────── Offer ──────────────────────────── -->
      <section class="section section--alt offer">
        <div class="shell offer__inner">
          <div class="offer__copy">
            <p class="highlight" data-i18n="offer.badge">30 days free</p>
            <p class="offer__lead">
              <strong data-i18n="offer.leadStrong">Try HostBora free for 30 days.</strong>
              <span data-i18n="offer.lead"
                >Full Starter access with no payment details required. Set up your properties,
                collect this month&rsquo;s rent, and upgrade any time before or after the trial
                ends.</span
              >
            </p>

            <ul class="offer__list">
              <li data-i18n="offer.li1">Up to 3 properties across BnB and Rent</li>
              <li data-i18n="offer.li2">No credit card required</li>
              <li data-i18n="offer.li3">Upgrade or cancel any time</li>
            </ul>
            <div class="hero__actions">
              <a
                class="btn btn--primary"
                href="https://play.google.com/store/apps/details?id=tz.co.artbel.paa_yangu"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-i18n="offer.cta">Start free trial</span>
                <img src="./assets/ui/arrow-up-right-white.svg" width="20" height="20" alt="" />
              </a>

              <div class="store-note">
                <span class="store-note__label" data-i18n="cta.availableOn">Available on</span>
                <span class="store-chips">
                  <a
                    href="https://apps.apple.com/app/host-bora/id6760237277"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Download on the App Store"
                  >
                    <img src="./assets/ui/store-appstore.png" width="24" height="24" alt="App Store" />
                  </a>
                  <span aria-hidden="true">+</span>
                  <a
                    href="https://play.google.com/store/apps/details?id=tz.co.artbel.paa_yangu"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Get it on Google Play"
                  >
                    <img src="./assets/ui/store-play.png" width="24" height="24" alt="Google Play" />
                  </a>
                </span>
              </div>
            </div>

            <p class="hero__version" data-i18n="app.version">App v1.5.8 · Updated October 2026</p>
          </div>

          <figure class="offer__phone">
            <img
              src="./assets/home.jpg"
              width="239"
              height="512"
              alt="The HostBora home screen with quick actions for calendar, tenants, bookings and reports"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <!-- ─────────────────────────── Pricing ─────────────────────────── -->
      <section class="section" id="pricing">
        <div class="shell">
          <div class="section__head section__head--center">
            <p class="eyebrow">
              <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
              <span data-i18n="pricing.kicker">Pricing</span>
            </p>
            <h2 class="display" data-i18n="pricing.title">Simple, transparent pricing</h2>
            <p class="section__sub" data-i18n="pricing.sub">
              Start with a free 30-day trial — no credit card required. Then pick the monthly plan
              that fits your portfolio.
            </p>
          </div>

          <div class="pricing-grid">
            <article class="plan">
              <span class="plan__icon plan__icon--violet" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="plan__name" data-i18n="pricing.starter.name">Starter</h3>
              <p class="plan__summary" data-i18n="pricing.starter.summary">
                For solo hosts getting organised.
              </p>
              <p class="plan__price">
                <span class="display display--sm">19,000</span>
                <span class="plan__period" data-i18n="pricing.period">TZS / month</span>
              </p>
              <ul class="plan__features">
                <li data-i18n="pricing.starter.li1">Up to 3 properties</li>
                <li data-i18n="pricing.starter.li2">BnB and Rent, bookings, and calendar</li>
                <li data-i18n="pricing.starter.li3">Tenants, income, expenses, and reminders</li>
                <li data-i18n="pricing.starter.li4">Home occupancy and collection</li>
                <li data-i18n="pricing.starter.li5">Your own maintenance tasks</li>
                <li data-i18n="pricing.starter.li6">Guest history and rewards</li>
              </ul>
              <a class="btn btn--soft btn--block" href="#contact">
                <span data-i18n="cta.install">Install now</span>
                <img src="./assets/ui/arrow-up-right-teal.svg" width="20" height="20" alt="" />
              </a>
              <p class="plan__note" data-i18n="pricing.renews">
                Renews automatically. Cancel anytime.
              </p>
            </article>

            <article class="plan plan--featured">
              <p class="plan__ribbon" data-i18n="pricing.pro.badge">Our recommendation</p>
              <span class="plan__icon plan__icon--mint" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M5 21V4h9l-1 3h6l-1.5 5 1.5 5h-9l-1-3H5" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="plan__name" data-i18n="pricing.pro.name">Pro</h3>
              <p class="plan__summary" data-i18n="pricing.pro.summary">
                For growing portfolios and small teams.
              </p>
              <p class="plan__price">
                <span class="display display--sm">49,000</span>
                <span class="plan__period" data-i18n="pricing.period">TZS / month</span>
              </p>
              <ul class="plan__features">
                <li data-i18n="pricing.pro.li1">Up to 10 properties</li>
                <li data-i18n="pricing.pro.li2">Staff, task assignment, and payroll</li>
                <li data-i18n="pricing.pro.li3">Calendar sync, SMS, and WhatsApp</li>
                <li data-i18n="pricing.pro.li4">Document vault, scanner, and inventory</li>
                <li data-i18n="pricing.pro.li5">Profit, ROI, and apartment reports</li>
                <li data-i18n="pricing.pro.li6">Loyalty, concierge, and manager network</li>
              </ul>
              <a class="btn btn--primary btn--block" href="#contact">
                <span data-i18n="cta.install">Install now</span>
                <img src="./assets/ui/arrow-up-right-white.svg" width="20" height="20" alt="" />
              </a>
              <p class="plan__note" data-i18n="pricing.renews">
                Renews automatically. Cancel anytime.
              </p>
            </article>

            <article class="plan">
              <span class="plan__icon plan__icon--lime" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path
                    d="m12 3 2.6 5.6 6.4.8-4.7 4.3 1.2 6.3-5.5-3-5.5 3 1.2-6.3L3 9.4l6.4-.8L12 3z"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <h3 class="plan__name" data-i18n="pricing.ultra.name">Ultra</h3>
              <p class="plan__summary" data-i18n="pricing.ultra.summary">
                For operators and property managers at scale.
              </p>
              <p class="plan__price">
                <span class="display display--sm">99,000</span>
                <span class="plan__period" data-i18n="pricing.period">TZS / month</span>
              </p>
              <ul class="plan__features">
                <li data-i18n="pricing.ultra.li1">Unlimited properties and staff</li>
                <li data-i18n="pricing.ultra.li2">Everything in Pro</li>
                <li data-i18n="pricing.ultra.li3">Smart locks and entry logs</li>
                <li data-i18n="pricing.ultra.li4">AI Manager and AI pricing</li>
                <li data-i18n="pricing.ultra.li5">Interior design studio</li>
                <li data-i18n="pricing.ultra.li6">Priority support</li>
              </ul>
              <a class="btn btn--soft btn--block" href="#contact">
                <span data-i18n="cta.install">Install now</span>
                <img src="./assets/ui/arrow-up-right-teal.svg" width="20" height="20" alt="" />
              </a>
              <p class="plan__note" data-i18n="pricing.renews">
                Renews automatically. Cancel anytime.
              </p>
            </article>
          </div>

          <p class="pricing-footnote" data-i18n="pricing.footnote" data-i18n-html>
            Prices are in Tanzanian shillings and shown in your own currency inside the app. Pay by
            mobile money on Android, or through the App Store on iPhone.
            <a href="#contact">Questions?</a> Chat with us on WhatsApp or email.
          </p>
        </div>
      </section>

      <!-- ──────────────────────────── Trust ──────────────────────────── -->
      <section class="section section--alt" id="trust">
        <div class="shell">
          <div class="section__head section__head--split">
            <div>
              <p class="eyebrow">
                <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
                <span data-i18n="trust.kicker">Trust</span>
              </p>
              <h2 class="display" data-i18n="trust.title">Built for how you work in East Africa</h2>
            </div>
            <p class="section__sub" data-i18n="trust.sub">
              Professional, dependable and respectful of local realities — not a generic import.
            </p>
          </div>

          <div class="trust__layout">
            <ul class="trust-list">
              <li>
                <h3 data-i18n="trust.offline.title">Works offline</h3>
                <p data-i18n="trust.offline.desc">
                  Keep recording payments, notes and tasks when connectivity dips — everything syncs
                  when you are back online.
                </p>
              </li>
              <li>
                <h3 data-i18n="trust.tzs.title">TZS-friendly</h3>
                <p data-i18n="trust.tzs.desc">
                  Think in Tanzanian shillings and the mobile money you already use — M-Pesa, Tigo
                  Pesa and Airtel Money — with live FX when an owner thinks in dollars.
                </p>
              </li>
              <li>
                <h3 data-i18n="trust.security.title">Security &amp; privacy</h3>
                <p data-i18n="trust.security.desc" data-i18n-html>
                  Your property and tenant data stay yours, encrypted in transit and at rest. We
                  collect only what the service needs — see our
                  <a href="./privacy-policy.html">Privacy Policy</a>.
                </p>
              </li>
            </ul>

            <div class="trust__panel">
              <div class="mock-chart">
                <div class="mock-chart__tabs">
                  <span class="is-active" data-i18n="trust.chart.income">Income</span>
                  <span data-i18n="trust.chart.expenses">Expenses</span>
                </div>
                <p class="mock-chart__value">
                  <small data-i18n="trust.chart.caption">Collected this week</small>
                  <strong>3.4M TZS</strong>
                </p>
                <div class="mock-chart__bars" role="img" aria-label="Rent collected across seven days, rising midweek">
                  <span style="--h: 42%"></span>
                  <span style="--h: 55%"></span>
                  <span class="is-teal" style="--h: 70%"></span>
                  <span class="is-teal" style="--h: 88%"></span>
                  <span class="is-teal" style="--h: 100%"></span>
                  <span style="--h: 48%"></span>
                  <span class="is-teal" style="--h: 64%"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ─────────────────────────── Contact ─────────────────────────── -->
      <section class="section contact" id="contact">
        <div class="shell contact__inner">
          <div class="contact__copy">
            <p class="eyebrow">
              <img src="./assets/ui/star-north.svg" width="16" height="16" alt="" />
              <span data-i18n="contact.kicker">Connect</span>
            </p>
            <h2 class="display display--xl" data-i18n="contact.title">
              Kick things off with HostBora
            </h2>
            <p class="section__sub" data-i18n="contact.sub">
              Available on mobile for hosts, landlords and managers in Tanzania and the wider East
              Africa region. Reach out for early access, partnerships or support.
            </p>

            <a
              class="btn btn--whatsapp"
              href="https://wa.me/255789287509"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src="./assets/ui/icon-whatsapp.svg" width="20" height="20" alt="" />
              <span data-i18n="contact.whatsapp">Chat on WhatsApp</span>
            </a>

            <div class="contact__direct">
              <p data-i18n="contact.or">Or directly connect with us</p>
              <a id="emailBtn" href="mailto:support@hostbora.co.tz">
                <img src="./assets/ui/icon-mail.svg" width="24" height="24" alt="" />
                <span>support@hostbora.co.tz</span>
              </a>
            </div>
          </div>

          <form class="form" id="contactForm" novalidate>
            <div class="field">
              <label for="cf-name" data-i18n="contact.name">Name</label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                data-i18n-placeholder="contact.namePlaceholder"
                placeholder="Joseph Mwita"
                required
              />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="cf-email" data-i18n="contact.email">Email *</label>
                <input
                  id="cf-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  data-i18n-placeholder="contact.emailPlaceholder"
                  placeholder="yourname@email.com"
                  required
                />
              </div>

              <div class="field">
                <label for="cf-type" data-i18n="contact.propertyType">Property type *</label>
                <div class="field__select">
                  <select id="cf-type" name="propertyType" required>
                    <option value="" data-i18n="contact.select">Select</option>
                    <option value="bnb" data-i18n="contact.typeBnb">Short-stay / BnB</option>
                    <option value="rent" data-i18n="contact.typeRent">Long-term rent</option>
                    <option value="mixed" data-i18n="contact.typeMixed">Both</option>
                    <option value="managing" data-i18n="contact.typeManaging">
                      I manage for owners
                    </option>
                  </select>
                  <img src="./assets/ui/icon-chevron-down.svg" width="20" height="20" alt="" />
                </div>
              </div>
            </div>

            <div class="field">
              <label for="cf-message" data-i18n="contact.message">Your message</label>
              <textarea
                id="cf-message"
                name="message"
                rows="4"
                data-i18n-placeholder="contact.messagePlaceholder"
                placeholder="How many properties do you run, and what is hardest right now?"
                required
              ></textarea>
            </div>

            <input
              class="field__honeypot"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <button class="btn btn--primary btn--block" id="contactBtn" type="submit">
              <span data-i18n="contact.submit">Submit now</span>
            </button>

            <p class="form__status" id="contactFeedback" role="status" aria-live="polite"></p>
            <p class="form__hint" data-i18n="contact.hint">
              WhatsApp is fastest — or use the form and we&rsquo;ll reply by email.
            </p>
          </form>
        </div>
      </section>
    </main>

    <!-- ──────────────────────────── Footer ──────────────────────────── -->
    <footer class="site-footer">
      <img
        class="site-footer__watermark"
        src="./assets/ui/footer-watermark.svg"
        width="1109.33"
        height="182.061"
        alt=""
        aria-hidden="true"
      />

      <div class="shell site-footer__inner">
        <div class="site-footer__brand">
          <a class="brand brand--light" href="#main" data-i18n-aria-label="brand.home" aria-label="HostBora home">
            <span class="brand__mark brand__mark--lg" aria-hidden="true">
              <img src="./assets/ui/logo-mark-light-a.svg" width="36.7372" height="33.9658" alt="" />
              <img src="./assets/ui/logo-mark-light-b.svg" width="17.7236" height="23.7822" alt="" />
            </span>
            <img
              class="brand__wordmark"
              src="./assets/ui/wordmark-light.svg"
              width="154.038"
              height="25.2799"
              alt="HostBora"
            />
          </a>

          <p class="site-footer__about" data-i18n="footer.about" data-i18n-html>
            Property management for landlords, managers and hosts. Built by
            <strong>Artbel Technologies</strong> in Dar es Salaam — the Tanzanian team behind
            HostBora.
          </p>

          <a
            class="btn btn--brand"
            href="https://play.google.com/store/apps/details?id=tz.co.artbel.paa_yangu"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span data-i18n="footer.getApp">Get the app now</span>
            <img src="./assets/ui/arrow-up-right-white.svg" width="20" height="20" alt="" />
          </a>
        </div>

        <nav class="site-footer__links" data-i18n-aria-label="footer.navLabel" aria-label="Footer">
          <div>
            <h2 data-i18n="footer.sections">Sections</h2>
            <ul>
              <li><a href="#features" data-i18n="nav.features">Features</a></li>
              <li><a href="#workspaces" data-i18n="nav.workspaces">Workspaces</a></li>
              <li><a href="#audience" data-i18n="nav.audience">Who uses it</a></li>
              <li><a href="#pricing" data-i18n="nav.pricing">Pricing</a></li>
              <li><a href="#trust" data-i18n="nav.trust">Trust</a></li>
            </ul>
          </div>

          <div>
            <h2 data-i18n="footer.policies">Policies</h2>
            <ul>
              <li><a href="./privacy-policy.html" data-i18n="nav.privacy">Privacy policy</a></li>
              <li><a href="./terms-of-service.html" data-i18n="footer.terms">Terms &amp; conditions</a></li>
              <li><a href="./about.html" data-i18n="nav.about">About</a></li>
              <li>
                <a href="mailto:security@hostbora.co.tz" data-i18n="footer.vulnerability"
                  >Report a vulnerability</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h2 data-i18n="footer.social">Social links</h2>
            <ul class="site-footer__social">
              <li>
                <a href="https://wa.me/255789287509" target="_blank" rel="noopener noreferrer">
                  <span data-i18n="nav.whatsapp">WhatsApp</span>
                  <img src="./assets/ui/arrow-up-right-muted.svg" width="16" height="16" alt="" />
                </a>
              </li>
              <li>
                <a href="https://www.instagram.com/hostbora" target="_blank" rel="noopener noreferrer">
                  <span>Instagram</span>
                  <img src="./assets/ui/arrow-up-right-muted.svg" width="16" height="16" alt="" />
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/hostbora" target="_blank" rel="noopener noreferrer">
                  <span>Facebook</span>
                  <img src="./assets/ui/arrow-up-right-muted.svg" width="16" height="16" alt="" />
                </a>
              </li>
              <li>
                <a href="https://www.linkedin.com/company/hostbora" target="_blank" rel="noopener noreferrer">
                  <span>LinkedIn</span>
                  <img src="./assets/ui/arrow-up-right-muted.svg" width="16" height="16" alt="" />
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </div>

      <div class="shell site-footer__base">
        <p data-i18n="footer.copyright">© 2026 Artbel Technologies. All rights reserved.</p>
        <p data-i18n="app.version">App v1.5.8 · Updated October 2026</p>
      </div>
    </footer>

    <script src="./i18n.js"></script>
    <script src="./app.js"></script>
  </body>
